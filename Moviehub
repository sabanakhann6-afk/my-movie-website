
<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MOVIE HUB</title>
<style>
*{box-sizing:border-box}
body{
 margin:0;
 background:#101018;
 color:white;
 font-family:Arial,sans-serif;
}
header{
 background:#191925;
 padding:20px;
 text-align:center;
 border-bottom:2px solid #ff3030;
}
header h1{color:#ff3030;margin:0}
header p{color:#bbb}
.search{
 width:90%;max-width:500px;
 padding:14px;margin:20px auto;
 display:block;border-radius:25px;
 border:1px solid #555;
 background:#242432;color:white;
}
.categories{text-align:center;padding:10px}
.categories button{
 background:#282838;color:white;
 border:0;padding:10px 15px;
 margin:4px;border-radius:20px;
 cursor:pointer;
}
.categories button:hover{background:#ff3030}
h2{text-align:center;color:#ff4545}
.movies{
 display:grid;
 grid-template-columns:repeat(auto-fit,minmax(145px,1fr));
 gap:15px;padding:15px;
}
.movie{
 background:#20202d;
 border-radius:12px;
 overflow:hidden;
 text-align:center;
 padding-bottom:15px;
}
.movie img{
 width:100%;height:210px;
 object-fit:cover;
}
.movie h3{font-size:16px}
.movie p{color:#bbb;font-size:13px}
.movie a{
 display:inline-block;
 background:#ff3030;
 color:white;text-decoration:none;
 padding:9px 15px;border-radius:20px;
 font-size:13px;
}
footer{
 text-align:center;padding:25px;
 color:#aaa;background:#191925;
 margin-top:30px;
}
</style>
</head>
<body>

<header>
<h1>🎬 MOVIE HUB</h1>
<p>Your Entertainment Destination</p>
</header>

<input class="search" id="search"
placeholder="Search your favourite movie..."
oninput="searchMovies()">

<div class="categories">
<button onclick="filterMovies('All')">All</button>
<button onclick="filterMovies('Bollywood')">Bollywood</button>
<button onclick="filterMovies('Hollywood')">Hollywood</button>
<button onclick="filterMovies('Drama')">Drama</button>
<button onclick="filterMovies('Web Series')">Web Series</button>
</div>

<h2>Latest Movies</h2>

<div class="movies" id="movies">

<div class="movie" data-category="Bollywood">
<img src="https://placehold.co/300x420/252535/ffffff?text=Jawan" alt="Jawan">
<h3>Jawan</h3><p>Bollywood</p>
<a href="https://www.justwatch.com/in" target="_blank">Watch Options</a>
</div>

<div class="movie" data-category="Bollywood">
<img src="https://placehold.co/300x420/252535/ffffff?text=Pathaan" alt="Pathaan">
<h3>Pathaan</h3><p>Bollywood</p>
<a href="https://www.justwatch.com/in" target="_blank">Watch Options</a>
</div>

<div class="movie" data-category="Hollywood">
<img src="https://placehold.co/300x420/252535/ffffff?text=Avatar" alt="Avatar">
<h3>Avatar</h3><p>Hollywood</p>
<a href="https://www.justwatch.com/in" target="_blank">Watch Options</a>
</div>

<div class="movie" data-category="Hollywood">
<img src="https://placehold.co/300x420/252535/ffffff?text=Avengers" alt="Avengers">
<h3>Avengers</h3><p>Hollywood</p>
<a href="https://www.justwatch.com/in" target="_blank">Watch Options</a>
</div>

<div class="movie" data-category="Drama">
<img src="https://placehold.co/300x420/252535/ffffff?text=Drama" alt="Drama">
<h3>Drama Collection</h3><p>Drama</p>
<a href="https://www.justwatch.com/in" target="_blank">Watch Options</a>
</div>

<div class="movie" data-category="Web Series">
<img src="https://placehold.co/300x420/252535/ffffff?text=Series" alt="Web Series">
<h3>Web Series</h3><p>Web Series</p>
<a href="https://www.justwatch.com/in" target="_blank">Watch Options</a>
</div>

</div>

<footer>
<h3>🎬 MOVIE HUB</h3>
<p>Discover Movies & Entertainment</p>
<p>© 2026 Movie Hub</p>
</footer>

<script>
function filterMovies(category){
 document.querySelectorAll('.movie').forEach(movie=>{
 movie.style.display =
 category==='All' ||
 movie.dataset.category===category ? 'block':'none';
 });
}

function searchMovies(){
 let value=document.getElementById('search').value.toLowerCase();
 document.querySelectorAll('.movie').forEach(movie=>{
 movie.style.display=movie.innerText.toLowerCase().includes(value)
 ? 'block':'none';
 });
}
</script>

</body>
</html>

